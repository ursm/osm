# Environment file for osm@.service, installed as /etc/default/osm.

# Key mappings in the form "SRC=DEST ...".
# Run `osm --help` for where to find the available key names.
#
# osm is disabled until you set a mapping: with none, each osm@.service starts,
# finds an empty keymap, and exits without touching the keyboard. Uncomment the
# line below (and edit it to taste) to enable osm.
#KEYMAP="LeftShift=Home RightShift=End"
